{
  "name": "ai-fitness-coach-backend",
  "version": "1.0.0",
  "description": "AI Fitness Coach Backend Server",
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc --skipLibCheck && tsc-alias",
    "start": "node dist/index.js",
    "start:dev": "ts-node-dev --files -r tsconfig-paths/register src/index.ts",
    "seed": "ts-node-dev --files -r tsconfig-paths/register src/seeder/seed.ts",
    "seed:reset": "ts-node --files -r tsconfig-paths/register src/seeder/seed.ts --reset"
  },
  "author": "Riteek Gore",
  "license": "ISC",
  "engines": {
    "node": "18.x"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@types/express": "^4.17.21",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.8",
    "nodemon": "^3.0.2",
    "rimraf": "^5.0.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-joi-validation": "^5.0.1",
    "glob": "^10.3.10",
    "joi": "^17.12.1",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "mongoose": "^7.6.0",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^10.0.0"
  }
}
